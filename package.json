{
  "name": "hyperbug",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11.26.0 <12"
  },
  "scripts": {
    "dev:node": "tsx watch apps/api-node/src/index.ts",
    "dev:cloudflare": "wrangler dev --config apps/api-cloudflare/wrangler.jsonc",
    "build": "node tooling/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/api-cloudflare",
    "lint": "oxlint --deny-warnings apps packages tooling tests && node tooling/check-boundaries.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project unit --project contract && vitest run --project node && vitest run --project workerd && corepack pnpm test:postgres",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project node && vitest run --project workerd && corepack pnpm test:postgres",
    "test:node": "vitest run --project node",
    "test:workerd": "vitest run --project workerd",
    "scan:licenses": "corepack pnpm licenses list --json | node tooling/licenses.mjs",
    "scan:secrets": "node tooling/secrets.mjs",
    "types:cloudflare": "wrangler types --config apps/api-cloudflare/wrangler.jsonc apps/api-cloudflare/worker-configuration.d.ts",
    "db:generate:d1": "drizzle-kit generate --config packages/database/d1/drizzle.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config packages/database/postgres/drizzle.config.ts",
    "test:postgres": "node tooling/postgres-test-cluster.mjs node node_modules/vitest/vitest.mjs run --project postgres",
    "dev:storage": "node tooling/local-s3.ts",
    "db:check": "drizzle-kit check --config packages/database/d1/drizzle.config.ts && drizzle-kit check --config packages/database/postgres/drizzle.config.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply hyperbug-local --local --config apps/api-cloudflare/wrangler.jsonc",
    "db:migrate:postgres": "node tooling/migrate-postgres.ts",
    "test:database": "vitest run --project workerd tests/workerd/repository.test.ts && corepack pnpm test:postgres",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@elysia/node": "1.4.6",
    "@hyperbug/application": "workspace:*",
    "@hyperbug/config": "workspace:*",
    "@hyperbug/contracts": "workspace:*",
    "@hyperbug/database-d1": "workspace:*",
    "@hyperbug/database-postgres": "workspace:*",
    "@hyperbug/domain": "workspace:*",
    "@hyperbug/observability": "workspace:*",
    "@hyperbug/server": "workspace:*",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "elysia": "1.4.30",
    "miniflare": "5.20260916.0-alpha",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "pg": "8.23.0",
    "rolldown": "1.2.9",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  }
}
