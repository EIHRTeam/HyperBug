{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tooling/**",
      "tests/**",
      "!!**/dist",
      "!!**/migrations",
      "!!**/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
