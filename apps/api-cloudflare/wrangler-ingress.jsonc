{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hyperbug-ingress-local",
  "main": "src/ingress.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["HYPERBUG_INGRESS_KEY"] },
  "services": [{ "binding": "API", "service": "hyperbug-api-local" }],
  "env": {
    "staging": {
      "name": "hyperbug-ingress-staging",
      "secrets": { "required": ["HYPERBUG_INGRESS_KEY"] },
      "services": [{ "binding": "API", "service": "hyperbug-api-staging" }],
    },
    "production": {
      "name": "hyperbug-ingress",
      "secrets": { "required": ["HYPERBUG_INGRESS_KEY"] },
      "services": [{ "binding": "API", "service": "hyperbug-api" }],
    },
  },
}
