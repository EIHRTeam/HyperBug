{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "scripts", "fixtures", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
